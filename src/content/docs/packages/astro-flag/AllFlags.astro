import { Flag, allFlags, type FlagName } from "astro-flag";


---

<div class="container">
  {
    allFlags.map((flag) => (
      <div>
        <Flag flagName=`${flag}` width="100%" />
        <br>
        {flag}
      </div>
    ))
  }

</div>


<style>
  .container {
    font-family: 'Nimbus Mono PS', 'Courier New', monospace;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    gap: 1rem;
    text-align: center;
    font-weight: 900;
  }
</style>